# .github/cicd/config - this repo's settings for the pipelines vendored from
# https://github.com/omerfsen/cicd. Plain KEY=value lines, read by the
# workflows from main (so a PR cannot change them for itself).

PIPELINES=release-please pr-title ansible-galaxy upstream-images

# release-please: bumps these, writes CHANGELOG.md, tags vX.Y.Z (which
# publishes to Galaxy through ansible-galaxy). Runs as the release GitHub
# App (RELEASE_APP_ID / RELEASE_APP_KEY in the "release" environment).
# On since the lab passed end to end (from scratch, then changed=0); a
# Galaxy version can never be re-uploaded, so turn it off before merging
# anything half-built.
VERSION_FILES=version.txt galaxy.yml
RELEASE_PLEASE_ENABLED=true
RELEASE_PLEASE_RUNNER=ubuntu-24.04

PR_TITLE_ENABLED=true
PR_TITLE_RUNNER=ubuntu-24.04

# ansible-galaxy: lint, importer and build on every PR and push to main;
# publish to Galaxy only from a vX.Y.Z tag that matches galaxy.yml.
ANSIBLE_GALAXY_ENABLED=true
ANSIBLE_GALAXY_RUNNER=ubuntu-24.04
ANSIBLE_GALAXY_PATH=.
ANSIBLE_GALAXY_LINT_PROFILE=production
ANSIBLE_GALAXY_PUBLISH=true
ANSIBLE_GALAXY_ENVIRONMENT=galaxy

# upstream-images: MANUAL ONLY (Actions -> upstream-images -> Run workflow).
# Builds NICo's images from source at the pinned tag and commit with
# tools/build-nico-images.sh and pushes them to Docker Hub (variable
# DOCKERHUB_USERNAME and secret DOCKERHUB_TOKEN in the "images" environment).
# The build needs about 72 GB of disk: a GitHub-hosted runner may not fit.
UPSTREAM_IMAGES_ENABLED=true
UPSTREAM_IMAGES_RUNNER=ubuntu-24.04
UPSTREAM_IMAGES_REPO=https://github.com/dsx-ai-factory/infra-controller.git
UPSTREAM_IMAGES_REF=v2.3.0
UPSTREAM_IMAGES_COMMIT=abc446b33dc773d9b8c7f41b54cccf812758b165
UPSTREAM_IMAGES_SCRIPT=tools/build-nico-images.sh
UPSTREAM_IMAGES_REGISTRY=docker.io/omerfsen
UPSTREAM_IMAGES_ENVIRONMENT=images
UPSTREAM_IMAGES_FREE_DISK=true
