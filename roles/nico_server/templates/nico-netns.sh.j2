#!/bin/bash
# {{ ansible_managed }}
# Create or remove network namespace $1 with one veth into a bridge.
# Settings come from /etc/nico/netns/$1.env: BRIDGE, ADDRESS, PREFIX,
# GATEWAY, MAC. Idempotent.
set -euo pipefail
name=$1 action=${2:-up}
# shellcheck disable=SC1090
source "/etc/nico/netns/$name.env"
# Host end of the veth: interface names are at most 15 characters, so a
# prefix of the namespace name is not unique (bmc-nico-server-01 and -02);
# use a hash of it.
host_if="nn$(printf '%s' "$name" | sha256sum | cut -c1-12)"
if [ "$action" = down ]; then
  ip link del "$host_if" 2>/dev/null || true
  ip netns del "$name" 2>/dev/null || true
  exit 0
fi
for i in $(seq 1 120); do ip link show "$BRIDGE" >/dev/null 2>&1 && break; sleep 1; done
if ! ip link show "$host_if" >/dev/null 2>&1; then
  # No host end: start the namespace from scratch (its old veth goes with it).
  ip netns del "$name" 2>/dev/null || true
  ip netns add "$name"
  ip link add "$host_if" type veth peer name eth0 netns "$name"
fi
ip link set "$host_if" master "$BRIDGE" up
ip -n "$name" link set eth0 address "$MAC"
ip -n "$name" link set lo up
ip -n "$name" link set eth0 up
ip -n "$name" addr replace "$ADDRESS/$PREFIX" dev eth0
ip -n "$name" route replace default via "$GATEWAY"
